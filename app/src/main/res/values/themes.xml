<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema principal de la aplicación -->
    <style name="Theme.MyApplication" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Tema para la pantalla de carga (Splash Screen) -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Color de fondo táctico -->
        <item name="windowSplashScreenBackground">#0F172A</item>

        <!-- Imagen del escudo táctico de carga -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/img_splash_logo_1785855616063</item>

        <!-- Tema al que transita la app al finalizar la carga -->
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
    </style>

</resources>